TELEGRAM_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
BOT_USERNAME=
DB_PATH=powermatch.db

# راز API مدیریتی — یک مقدار تصادفی و طولانی بگذارید:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# اگر خالی یا change-me باشد، اندپوینت‌های /admin با خطای 503 غیرفعال می‌شوند.
ADMIN_SECRET=

# ادمین‌ها: با یوزرنیم (بدون @) و/یا با شناسه‌ی عددی چت، جداشده با کاما
ADMIN_USERNAMES=Farbod_Papoli
ADMIN_CHAT_IDS=

# میزبانی API؛ در داکر 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8000

# Google Sheets — راهنمای کامل با دستور /sheet در ربات
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_SHEET_ID=

# اگر پر شود، پنل مدیریت در یک ربات کاملاً جدا باز می‌شود
ADMIN_BOT_TOKEN=
ADMIN_BOT_USERNAME=

# حالت وب‌هوک (اختیاری) — جایگزین long polling، برای اجرا پشت nginx یا سکوهای ابری
USE_WEBHOOK=
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# اگر پر شود، دیتابیس روی Turso (libSQL) نگه‌داری می‌شود به‌جای فایل SQLite محلی؛
# برای اجرای بدون سرور (GitHub Actions) لازم است چون فایل محلی بین اجراها پاک می‌شود.
# با CLI: turso db create powermatch && turso db show powermatch --url && turso db tokens create powermatch
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
